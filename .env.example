# Environment Configuration Template
# Copy this file to .env and configure your settings.

# API keys for cloud providers. Only set the providers you use.
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Directories
DATA_DIR=data
MODELS_DIR=../models

# Logging
LOG_LEVEL=INFO

# Default model. Use a local GGUF path or a liteLLM identifier.
MODEL_PATH=../models/gemma-2-2b-it-Q8_0.gguf
# MODEL_PATH=openai/gpt-5.4-nano

# Device: auto, cpu, cuda, or mps
DEVICE=auto

# Audio
AUDIO_FORMAT=mp3
TTS_PROVIDER=qwen3
# TTS_MODEL=

# Images
ENABLE_IMAGES=true
IMAGE_PROVIDER=local
# IMAGE_MODEL=
# SD_MODEL_FILE=v1-5-pruned_Q4_0.gguf

# Optional CORS origin for frontend development or deployed API usage.
# FRONTEND_URL=https://your-domain.com
